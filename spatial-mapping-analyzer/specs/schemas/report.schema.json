{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "default": "unsupported",
          "enum": [
            "unsupported",
            "available"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "unit"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "enum": [
            "synthetic",
            "measured",
            "estimated"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "source"
      ],
      "title": "Objective",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "backend": {
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "backend_version": {
      "minLength": 1,
      "title": "Backend Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "unsupported",
        "error",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "mapping_hash": {
      "minLength": 1,
      "title": "Mapping Hash",
      "type": "string"
    },
    "correctness": {
      "default": "not_checked",
      "enum": [
        "not_checked",
        "passed",
        "failed"
      ],
      "title": "Correctness",
      "type": "string"
    },
    "objective": {
      "anyOf": [
        {
          "$ref": "#/$defs/Objective"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "object"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    }
  },
  "required": [
    "backend",
    "backend_version",
    "status",
    "mapping_hash"
  ],
  "title": "Report",
  "type": "object"
}
